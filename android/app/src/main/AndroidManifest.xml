<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the home screen shows every installed app (sideloaded app, not for the Play Store) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- granted with root at start, so the app may open the home and apps on the TV from the background -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- the TV home's Bluetooth panel (granted with root at start, so no pop-ups) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:label="Couch Phone"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Couch"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:resizeableActivity="true"
        android:supportsRtl="false">

        <!-- Samsung DeX: keep running when DeX starts or stops (no restart on the density change). -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />

        <!-- The setup screen: "Couch Phone" in the app list. Its own task (taskAffinity), so the TV home
             is never pulled onto the phone's screen with it, and DeX can open it on the TV. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:taskAffinity="app.couchphone.setup"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home screen page. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale">
            <!-- DeX: open as big as the screen, not in a small window -->
            <meta-data android:name="com.samsung.android.dex.launchwidth" android:value="0" />
            <meta-data android:name="com.samsung.android.dex.launchheight" android:value="0" />
        </activity>

        <!-- The Couch TV browser: website tiles open here, on the TV, with the remote's arrows. -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.couchphone.browser"
            android:resizeableActivity="true"
            android:hardwareAccelerated="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale">
            <meta-data android:name="com.samsung.android.dex.launchwidth" android:value="0" />
            <meta-data android:name="com.samsung.android.dex.launchheight" android:value="0" />
        </activity>

        <!-- Registers as a home app (launcher), so it can also be the phone's own home. -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".HomeActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local-network server for a phone remote control of the TV" />
        </service>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
